#include <stdio.h>
#include <stdlib.h>

struct Node{int value;struct Node* left;struct Node* right;};

int check(struct Node* r){
    if(r==NULL) return 0;
    int l=check(r->left);
    if(l==-1) return -1;
    int h=check(r->right);
    if(h==-1) return -1;
    if(l-h>1||h-l>1) return -1;
    return 1+(l>h?l:h);
}

int main(){
    struct Node a={1,NULL,NULL};
    struct Node b={2,NULL,NULL};
    struct Node c={3,&a,&b};
    printf("%d",check(&c)!=-1);
}
